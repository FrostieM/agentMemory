# Local-only memory service
LOCAL_ONLY=true
ALLOW_REMOTE_PROVIDERS=false

# API binding (host is hard-coded to 127.0.0.1 in code; only port is configurable)
MEMORY_API_PORT=8765

# Storage paths (relative to working directory unless absolute)
MEMORY_DB_PATH=./.agent_memory/memory.db
VECTOR_DB_PATH=./.agent_memory/vectors.lance

# Default logical workspace identifier inside the selected physical memory DB
MEMORY_WORKSPACE_ID=default
# Set true in per-project deployments to reject accidental workspace_id="default"
MEMORY_FORBID_DEFAULT_WORKSPACE=false

# Embedding backend: "sentence_transformers" (default) or "ollama"
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Used only when EMBEDDING_BACKEND=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Vector store backend: "lancedb" (default) or "sqlite_vec"
VECTOR_BACKEND=lancedb

# LLM backend for memory candidate extraction (Ollama is mandatory)
LLM_BACKEND=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct

# Optional: skip the Ollama probe at startup (only for tests / CI without Ollama)
OLLAMA_PROBE_SKIP=false

# Logging
LOG_LEVEL=INFO
