# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
build/
dist/
futureDesign/

# Virtualenvs
.venv/
venv/
env/

# Crash-test transient workspace + artifacts
tests/qa/qa-crash-test/
tests/qa/qa-crash-test-artifacts/

# Local data — never commit a real memory database
.agent_memory/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# LanceDB
*.lance/

# Env files (only the example is tracked)
.env
.env.local
.env.*.local

# Editor
.idea/
.vscode/
*.swp
.DS_Store

# Logs
*.log
logs/

# Per-developer Claude Code / agent runtime settings (contain absolute paths
# baked by setup_agent.py --project; not portable across machines)
.claude/
.codex/

# Per-project Claude Code MCP server config (absolute venv path + machine-pinned
# MEMORY_DB_PATH / MEMORY_WORKSPACE_ID; same non-portability as .claude/ above).
.mcp.json

# Per-developer analytic / triage reports (raw outputs from
# memory_*_report.py / hygiene / dashboard scripts; not portable
# across machines and frequently include per-machine paths).
reports/

# Per-developer screenshots / capture artifacts (regenerated locally
# by scripts/_attic/capture_ui_screenshots.py; they are 1+ MB each
# and would inflate the repo without serving public users).
docs/screenshots/

# Attic for retired scripts (one-off seeds, replaced crash tests,
# data-fix runners) that we keep on disk for reference but don't
# ship in the repo. New attic files require an explicit
# `git add -f` to land on git.
scripts/_attic/
