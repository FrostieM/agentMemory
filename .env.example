# Local-only memory service
LOCAL_ONLY=true
ALLOW_REMOTE_PROVIDERS=false

# API binding (host is hard-coded to 127.0.0.1 in code; only port is configurable)
MEMORY_API_PORT=8765

# Storage paths (relative to working directory unless absolute)
MEMORY_DB_PATH=./.agent_memory/memory.db
VECTOR_DB_PATH=./.agent_memory/vectors.lance

# Default logical workspace identifier inside the selected physical memory DB
MEMORY_WORKSPACE_ID=default
# Set true in per-project deployments to reject accidental workspace_id="default"
MEMORY_FORBID_DEFAULT_WORKSPACE=false
# Set true in per-project deployments to reject WRITES to any workspace except
# MEMORY_WORKSPACE_ID. Reads to other registered workspaces are still allowed
# (asymmetric isolation; see docs/adr/0005-asymmetric-isolation.md).
MEMORY_STRICT_WORKSPACE_ISOLATION=false
# Keep true so a DB declares its owning workspace and rejects mismatched startups
MEMORY_ENFORCE_WORKSPACE_MANIFEST=true

# Hub mode: one HTTP service serves many per-project SQLite+LanceDB pairs by
# routing requests via per-call X-Memory-DB-Path / X-Memory-Vector-Path
# (header) or db_path / vector_path (query param). Auto-enabled by serve.py
# when the registry has at least one entry; force on/off via this env or
# `--hub` / `--strict` CLI flags.  See docs/adr/0004-hub-mode.md.
MEMORY_HUB_MODE=false

# Workspace registry path. Updated by every `setup_agent.py --project` call
# and by `scripts/register_workspace.py {register|list|remove}`. The hub UI
# and HTTP service consult this file to route per-call X-Memory-DB-Path.
MEMORY_WORKSPACES_FILE=~/.agent_memory/workspaces.json

# Embedding backend: "sentence_transformers" (default) or "ollama"
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Used only when EMBEDDING_BACKEND=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Vector store backend: "lancedb" (default) or "sqlite_vec"
VECTOR_BACKEND=lancedb

# LLM backend for memory candidate extraction (Ollama is mandatory)
LLM_BACKEND=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:7b-instruct

# Optional: skip the Ollama probe at startup (only for tests / CI without Ollama)
OLLAMA_PROBE_SKIP=false

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Memory-quality features (default ON as of 1.1.0 calibration).
# Every flag below ships ON. Setting any flag explicitly here overrides the
# default — set to "false" / "0.0" to restore the v1.0.x baseline behaviour.
# Calibration evidence: docs/V1_1_0_CALIBRATION.md.
# Operator guide:        docs/V1_1_0.md.
# ---------------------------------------------------------------------------

# v1.0.x optional quality features (all on by default)
MEMORY_EPISODE_DEDUP_ENABLED=true
MEMORY_EPISODE_DEDUP_THRESHOLD=0.92
MEMORY_EPISODE_DEDUP_WINDOW=50
MEMORY_CONFIDENCE_DECAY_ENABLED=true
MEMORY_CONFIDENCE_DECAY_HALF_LIFE_DAYS=14
MEMORY_CONFLICT_DETECT_ENABLED=true
MEMORY_CONFLICT_DETECT_THRESHOLD=0.6
# 0 = disabled. Set to N to emit a compaction_due event after N chunks.
MEMORY_COMPACT_TRIGGER_THRESHOLD_CHUNKS=0

# v1.4 feedback-aware scoring + v2.1 implicit feedback derivation
MEMORY_FEEDBACK_EWMA_ENABLED=true
MEMORY_FEEDBACK_HALFLIFE_DAYS=14
MEMORY_FEEDBACK_EXCLUDE_SELF_LOOP=true
MEMORY_FEEDBACK_MAX_PER_DAY_PER_SOURCE=10
MEMORY_IMPLICIT_FEEDBACK_ENABLED=true

# v1.5 capability maturity + behavior-application tracking
MEMORY_CAPABILITY_MATURITY_ENABLED=true
MEMORY_CAPABILITY_DECAY_DAYS=30
MEMORY_CAPABILITY_STALE_DAYS=60
MEMORY_BEHAVIOR_APPLY_TRACKING_ENABLED=true

# v1.6 cold-memory lifecycle (last_retrieved_at + cold_candidate emission)
MEMORY_COLD_TRACKING_ENABLED=true
MEMORY_COLD_AUTO_QUEUE_ENABLED=true
MEMORY_COLD_STALE_DAYS=60
MEMORY_COLD_AUDIT_BATCH_SIZE=100

# v1.7 theory -> decision_candidates bridge (review-only, never auto-promotes)
MEMORY_THEORY_BRIDGE_ENABLED=true
MEMORY_THEORY_BRIDGE_MIN_EVIDENCE=3

# v1.8 reflective compaction (lesson extraction; gracefully degrades when Ollama unreachable)
MEMORY_REFLECTIVE_COMPACT_ENABLED=true
MEMORY_LESSON_MIN_SUPPORT_EPISODES=4
MEMORY_LESSON_MAX_PER_RUN=10

# v1.9 hygiene recurrence + sentinel persistence + v2.3 traffic-triggered scheduler
MEMORY_HYGIENE_PERSIST_ENABLED=true
MEMORY_SENTINEL_PERSIST_ENABLED=true
MEMORY_RECURRENCE_THRESHOLD=3
# v2.3 sentinel scheduler interval (hours). 0 = disabled.
MEMORY_SENTINEL_AUTORUN_HOURS=6.0

# v1.10 correction-aware learning loop. When enabled, the
# UserPromptSubmit hook reads the Claude Code transcript JSONL,
# locates the previous assistant claim, and if the current user
# prompt looks like a correction, ingests the pair so the
# CorrectionExtractor can propose a memory_candidate(kind=correction)
# for review. Operator promotes via /memory/promote_candidate_to_behavior.
MEMORY_CORRECTION_DETECT_ENABLED=true
MEMORY_CORRECTION_TRANSCRIPT_READ_ENABLED=true
MEMORY_CORRECTION_MIN_USER_LEN=30
MEMORY_CORRECTION_MIN_AGENT_LEN=50
MEMORY_CORRECTION_MIN_CONFIDENCE=0.5
MEMORY_CORRECTION_MAX_PER_DAY=20
MEMORY_CORRECTION_PAIR_WINDOW_MIN=30

# v3.0.0-final follow-ups (agent UX polish)
# -----------------------------------------
# Drop the noisy ``deprecation_notice`` field from every v2-compat shim
# response. By default the shim emits the notice ONCE per legacy tool name
# per process so the migration hint surfaces once; set this to true to
# suppress it entirely (the next major release will retire the shim anyway).
MEMORY_SUPPRESS_DEPRECATION_NOTICES=false
# After this many seconds the v2-compat shim re-emits the deprecation
# banner for the same legacy tool name. Long-lived MCP stdio processes
# (days/weeks) get a periodic reminder instead of a one-shot at startup.
# Set to a huge value (e.g. 86400000) for once-per-process semantics.
MEMORY_DEPRECATION_TTL_SECONDS=3600

# Sticky-brief: when the caller passes ``session_id``, the FIRST brief for
# that (workspace, session) pair renders at the requested ``max_tokens``;
# subsequent calls in the same session shrink to the followup cap below.
# Long chats stop paying the full ~500-token tax on every prompt.
MEMORY_STICKY_BRIEF_ENABLED=true
MEMORY_STICKY_BRIEF_FOLLOWUP_TOKENS=200

# Aging-decisions brief section. Surfaces active, unpinned decisions older
# than N days with outcome_score == 0.0 (no implicit/explicit feedback
# accumulated). Read-only hint — never degrades outcome or archives. The
# agent sees them as a watch-out on session start so it can revisit and
# either confirm or supersede.
MEMORY_AGING_DECISIONS_ENABLED=true
MEMORY_AGING_DECISIONS_DAYS=30
MEMORY_AGING_DECISIONS_LIMIT=3

# v3.1 Vector 3 — structural blindspot detection. Surface tokens that
# appear in ≥ MIN_EPISODES distinct episodes but in ZERO active
# decisions in the lookback window. Read-only hint in the brief —
# the agent sees "discussed-but-not-decided" topics on session start
# and can propose a decision. Tokenization shares the project's
# standard stop-word filter (see capability_suggester._tokenize).
MEMORY_BLINDSPOT_DETECT_ENABLED=true
MEMORY_BLINDSPOT_LOOKBACK_DAYS=90
MEMORY_BLINDSPOT_MIN_EPISODES=5
MEMORY_BLINDSPOT_LIMIT=5
MEMORY_BLINDSPOT_SAMPLE_TOKENS_PER_EPISODE=80

# decision_neighbors performance bound (Audit 2 #6): cap candidate
# scan at N most-recently-updated active decisions to keep the
# write hot-path under a few ms even on workspaces with 1000+
# decisions. Increase if the long-tail of older decisions matters.
MEMORY_DECISION_NEIGHBOR_CANDIDATES=200

# Hub-mode cross-workspace write audit (Audit 1 #2): when in hub
# mode a write to a foreign workspace_id is allowed (operator chose
# a shared service) but is logged + audit_log'd so it's never silent.
# Set to false to silence the warning if your deployment intentionally
# does cross-workspace writes on every call.
MEMORY_HUB_WRITE_AUDIT_ENABLED=true

# Periodic SQLite hygiene from the sentinel/brain pass. WAL checkpoint
# runs every tick (cheap); VACUUM runs only when the per-workspace
# last_vacuum_at stamp is older than the interval.
MEMORY_DB_HYGIENE_ENABLED=true
MEMORY_VACUUM_INTERVAL_HOURS=168

# v3.1 Vector 1 MVP — Memory proposes experiments. Scans insights with
# confidence in [MIN, MAX] window and emits heuristic proto-theory
# proposals for operator review. Read-only research backlog — never
# auto-creates a theory row.
MEMORY_EXPERIMENT_PROPOSAL_ENABLED=true
MEMORY_EXPERIMENT_PROPOSAL_CONF_MIN=0.4
MEMORY_EXPERIMENT_PROPOSAL_CONF_MAX=0.7
MEMORY_EXPERIMENT_PROPOSAL_LIMIT=3
